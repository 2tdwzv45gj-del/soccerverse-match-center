def _sv_translate_text(text, language):
    if not text:
        return text
    merged = dict(_SV_EXTRA_TRANSLATIONS)
    for source, values in _SV_WORLD_TRANSLATIONS.get("it", {}).items():
        merged.setdefault(source, {})
        for lang in ("it", "en", "de", "es", "pt", "fr"):
            if source in _SV_WORLD_TRANSLATIONS.get(lang, {}):
                merged[source][lang] = _SV_WORLD_TRANSLATIONS[lang][source]
    if text in merged:
        return merged[text].get(language, merged[text].get("it", text))

    import re
    patterns = [
        (r"^(\d+)\s+PAESI DISPONIBILI$", {"it":r"\1 PAESI DISPONIBILI","en":r"\1 COUNTRIES AVAILABLE","de":r"\1 LÄNDER VERFÜGBAR","es":r"\1 PAÍSES DISPONIBLES","pt":r"\1 PAÍSES DISPONÍVEIS","fr":r"\1 PAYS DISPONIBLES"}),
        (r"^(\d+)\s+CLUBS\s+•\s+LEAGUE\s+(\d+)$", {"it":r"\1 CLUBS  •  LEAGUE \2","en":r"\1 CLUBS  •  LEAGUE \2","de":r"\1 VEREINE  •  LIGA \2","es":r"\1 CLUBES  •  LIGA \2","pt":r"\1 CLUBES  •  LIGA \2","fr":r"\1 CLUBS  •  LIGUE \2"}),
        (r"^CARICAMENTO CLUB — (.*)$", {"it":r"CARICAMENTO CLUB — \1…","en":r"LOADING CLUB — \1…","de":r"VEREIN WIRD GELADEN — \1…","es":r"CARGANDO CLUB — \1…","pt":r"A CARREGAR CLUBE — \1…","fr":r"CHARGEMENT DU CLUB — \1…"}),
        (r"^CARICAMENTO PARTITE — (.*)$", {"it":r"CARICAMENTO PARTITE — \1…","en":r"LOADING MATCHES — \1…","de":r"SPIELE WERDEN GELADEN — \1…","es":r"CARGANDO PARTIDOS — \1…","pt":r"A CARREGAR JOGOS — \1…","fr":r"CHARGEMENT DES MATCHS — \1…"}),
        (r"^(.+) PRESENTI$", {"it":r"\1 PRESENTI","en":r"\1 PRESENT","de":r"\1 ZUSCHAUER","es":r"\1 ASISTENTES","pt":r"\1 PRESENTES","fr":r"\1 SPECTATEURS"}),
        (r"^CLASSIFICA NON DISPONIBILE(.*)$", {"it":r"CLASSIFICA NON DISPONIBILE\1","en":r"STANDINGS UNAVAILABLE\1","de":r"TABELLE NICHT VERFÜGBAR\1","es":r"CLASIFICACIÓN NO DISPONIBLE\1","pt":r"CLASSIFICAÇÃO INDISPONÍVEL\1","fr":r"CLASSEMENT INDISPONIBLE\1"}),
    ]
    for pattern, values in patterns:
        if re.match(pattern, text):
            return re.sub(pattern, values.get(language, values["it"]), text)
    return text


def _sv_register_i18n(widget):
    """Store immutable source text on widgets so repeated language changes are lossless."""
    from PySide6.QtWidgets import QLabel, QPushButton, QLineEdit, QToolButton
    for child in [widget, *widget.findChildren(object)]:
        if isinstance(child, (QLabel, QPushButton, QToolButton)):
            txt = child.text()
            if txt and not child.property("sv_i18n_source"):
                child.setProperty("sv_i18n_source", txt)
        elif isinstance(child, QLineEdit):
            txt = child.placeholderText()
            if txt and not child.property("sv_i18n_placeholder"):
                child.setProperty("sv_i18n_placeholder", txt)


def _sv_retranslate_widget_tree(widget, language):
    from PySide6.QtWidgets import QLabel, QPushButton, QLineEdit, QToolButton
    for child in [widget, *widget.findChildren(object)]:
        if isinstance(child, (QLabel, QPushButton, QToolButton)):
            source = child.property("sv_i18n_source")
            if source:
                child.setText(_sv_translate_text(str(source), language))
        elif isinstance(child, QLineEdit):
            source = child.property("sv_i18n_placeholder")
            if source:
                child.setPlaceholderText(_sv_translate_text(str(source), language))



