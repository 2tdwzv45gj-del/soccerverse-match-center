def load_image(url: str, size: int) -> QPixmap:
    try:
        result = subprocess.run(
            ["curl", "-L", "-s", "--fail", url],
            capture_output=True,
            timeout=10,
            check=True,
        )
        pixmap = QPixmap()
        if not pixmap.loadFromData(result.stdout):
            return QPixmap()
        return pixmap.scaled(
            size,
            size,
            Qt.AspectRatioMode.KeepAspectRatio,
            Qt.TransformationMode.SmoothTransformation,
        )
    except Exception:
        return QPixmap()


