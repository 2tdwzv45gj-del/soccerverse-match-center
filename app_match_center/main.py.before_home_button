    def _sv_retranslate_world_all(self, language: str) -> None:
        for page in (getattr(self, "start_page", None), getattr(self, "search_page", None), getattr(self, "match_window", None)):
            if page is not None:
                _sv_register_i18n(page)
                _sv_retranslate_widget_tree(page, language)



    def _language_changed(self, code: str) -> None:
        I18N.set_language(code)
        try:
            self.setWindowTitle(I18N.t("app_name", "SV LIVE SCORE"))
        except Exception:
            pass
        self._sv_retranslate_world_all(code)
        if getattr(self, "start_page", None) is not None:
            self.start_page.retranslate()
        if getattr(self, "search_page", None) is not None:
            # Keep the canonical source map, then update the existing World/Search UI.
            _sv_retranslate_widget_tree(self.search_page, code)

    def open_match(self, fixture_id: int) -> None:
        try:
            match = MatchCenterWindow(
                fixture_id,
                back_callback=self.show_search,
            )
            _sv_register_i18n(match)
            _sv_retranslate_widget_tree(match, getattr(I18N, "language", "it"))
        except Exception as exc:
            self.search_page.status.setText(
                f"Impossibile aprire la partita: {exc}"
            )
            return

        if self.match_window is not None:
            self.stack.removeWidget(self.match_window)
            self.match_window.deleteLater()

        self.match_window = match
        self.stack.addWidget(match)
        self.stack.setCurrentWidget(match)

    def show_search(self) -> None:
        self.stack.setCurrentWidget(self.search_page)


