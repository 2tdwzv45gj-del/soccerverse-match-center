class RinconNames:
    """Local El Rincon datapack names used only for presentation."""

    def __init__(self) -> None:
        self._loaded = False
        self._clubs: dict[str, str] = {}
        self._leagues: dict[tuple[str, str], str] = {}
        self._league_ids: dict[str, str] = {}
        self._cups: dict[str, str] = {}
        self.source_url = "https://pack.elrincondeldt.com/sv/rincon_s4.json"
        self.last_refresh_error = ""

    def refresh_remote(self) -> tuple[bool, str]:
        """Refresh the local Rincon pack from the maintained public JSON."""
        path = (
            Path(__file__).resolve().parent.parent
            / "data"
            / "raw"
            / "datapack"
            / "rincon_s4.json"
        )
        try:
            response = requests.get(
                self.source_url,
                headers={"User-Agent": "Soccerverse-Tactical-Advisor/1.0"},
                timeout=30,
            )
            response.raise_for_status()
            raw = response.content
            parsed = json.loads(raw.decode("utf-8"))
            pack = parsed.get("PackData", parsed)
            if not isinstance(pack, dict) or "ClubData" not in pack:
                raise ValueError("Rincon pack non valido")

            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_suffix(".json.tmp")
            tmp.write_bytes(raw)
            tmp.replace(path)

            self._loaded = False
            self._clubs.clear()
            self._leagues.clear()
            self._league_ids.clear()
            self._cups.clear()
            self.last_refresh_error = ""

            digest = hashlib.sha256(raw).hexdigest()[:12]
            return True, f"RINCON AGGIORNATO • {len(raw):,} BYTE • {digest}"
        except Exception as exc:
            self.last_refresh_error = str(exc)
            return False, f"RINCON LOCALE MANTENUTO • {exc}"

    def _load(self) -> None:
        if self._loaded:
            return
        self._loaded = True

        try:
            path = (
                Path(__file__).resolve().parent.parent
                / "data"
                / "raw"
                / "datapack"
                / "rincon_s4.json"
            )
            raw = json.loads(path.read_text(encoding="utf-8"))
            pack = raw.get("PackData", raw)

            clubs = (pack.get("ClubData") or {}).get("C") or []
            for row in clubs:
                if isinstance(row, dict) and row.get("id") is not None and row.get("n"):
                    self._clubs[str(row["id"])] = str(row["n"]).replace("~", " ")

            leagues = (pack.get("LeagueData") or {}).get("L") or []
            for row in leagues:
                if not isinstance(row, dict) or not row.get("n"):
                    continue
                country = str(row.get("c") or "").upper()
                division = str(row.get("d") or "")
                if country and division:
                    name = str(row["n"]).replace("~", " ")
                    self._leagues[(country, division)] = name
                    league_id = row.get("i") or row.get("id")
                    if league_id is not None:
                        self._league_ids[str(league_id).upper()] = name

            cups = (pack.get("CupData") or {}).get("C") or []
            for row in cups:
                if not isinstance(row, dict) or not row.get("n"):
                    continue
                cup_id = str(row.get("id") or "").upper()
                if cup_id:
                    self._cups[cup_id] = str(row["n"]).replace("~", " ")

        except Exception:
            # Presentation falls back to live Soccerverse names if the
            # local datapack is unavailable.
            return

    def club_name(self, club_id, fallback: str = "") -> str:
        self._load()
        return self._clubs.get(str(club_id), fallback)

    def league_name(self, country_id, division, fallback: str = "") -> str:
        self._load()
        country = str(country_id or "").upper()
        try:
            div = int(division)
        except Exception:
            div = None

        if div is not None:
            # Support both the current 1-based MCP division and older
            # 0-based API responses documented by Soccerverse.
            for candidate in (str(div), str(div + 1)):
                name = self._leagues.get((country, candidate))
                if name:
                    return name

        return fallback

    def cup_name(self, country_id, comp_id=None, fallback: str = "") -> str:
        self._load()
        for value in (comp_id, country_id):
            if value is not None:
                name = self._cups.get(str(value).upper())
                if name:
                    return name
        return fallback

    def competition_name(self, row: dict, fallback: str = "") -> str:
        if not isinstance(row, dict):
            return fallback

        explicit = str(
            row.get("comp_name")
            or row.get("competition_name")
            or row.get("league_name")
            or ""
        ).strip()

        country = row.get("country_id") or row.get("country")
        division = (
            row.get("division")
            or row.get("league_division")
            or row.get("division_id")
        )
        comp_type = row.get("comp_type")
        comp_id = (
            row.get("comp_id")
            or row.get("competition_id")
            or row.get("league_id")
            or row.get("cup_id")
        )
        comp_key = str(comp_id).upper() if comp_id is not None else ""

        # PRIMARY RULE: resolve the actual competition id from the datapack.
        # This avoids confusing a cup fixture with a league fixture merely
        # because the fixture also carries the club's domestic division.
        if comp_key:
            league_by_id = self._league_ids.get(comp_key)
            if league_by_id:
                return league_by_id

            cup = self.cup_name(country, comp_id, "")
            if cup:
                return cup

        # SECONDARY RULE: only use the league division when the row itself
        # clearly identifies it as a league (or provides no competition id).
        if comp_type in (None, "", 0, "0"):
            league = self.league_name(country, division, "")
            if league:
                return league

        return explicit or fallback


RINCON_NAMES = RinconNames()


class SearchWindow(QWidget):
    match_selected = Signal(int)

    MCP_URL = "https://mcp.soccerverse.io/mcp"

    def __init__(self, mcp: SoccerverseMCPClient, datapack: DatapackResolver) -> None:
        super().__init__()

        self.mcp = mcp
        self.datapack = datapack
        self.search_service = MatchSearchService(mcp, datapack)

        self._matches = []
        self._countries = []
        self._country = None
        self._leagues = []
        self._saved_clubs: list[dict] = []
        self._competition_cache: dict[str, str] = {}
        self._saved_clubs_path = Path(__file__).resolve().parent.parent / "saved_clubs.json"
        self._load_saved_clubs()

        self._build_ui()

    def _mcp_call(self, tool_name: str, arguments: dict) -> dict:
        import requests

        payload = {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {
                "name": tool_name,
                "arguments": arguments,
            },
        }

        response = requests.post(
            self.MCP_URL,
            headers={"Content-Type": "application/json"},
            json=payload,
            timeout=30,
        )
        response.raise_for_status()

        data = response.json()
        result = data.get("result", {})
        content = result.get("content", [])
        if not content:
            raise RuntimeError(f"MCP: risposta vuota per {tool_name}")

        raw = content[0].get("text", "")
        if isinstance(raw, str):
            import json
            return json.loads(raw)

        return raw

    @staticmethod
    def _flag_for_country(country_id: str) -> str:
        """Return an emoji flag from a 3-letter ISO country code."""
        iso3_to_iso2 = {
            "ITA": "IT", "DEU": "DE", "ESP": "ES", "FRA": "FR",
            "ENG": "GB", "GBR": "GB", "PRT": "PT", "NLD": "NL",
            "BEL": "BE", "CHE": "CH", "AUT": "AT", "GRC": "GR",
            "TUR": "TR", "DNK": "DK", "SWE": "SE", "NOR": "NO",
            "FIN": "FI", "POL": "PL", "CZE": "CZ", "SVK": "SK",
            "HUN": "HU", "ROU": "RO", "BGR": "BG", "HRV": "HR",
            "SRB": "RS", "SVN": "SI", "BIH": "BA", "ALB": "AL",
            "MKD": "MK", "MNE": "ME", "IRL": "IE", "ISL": "IS",
            "USA": "US", "CAN": "CA", "MEX": "MX", "BRA": "BR",
            "ARG": "AR", "CHL": "CL", "COL": "CO", "URY": "UY",
            "JPN": "JP", "KOR": "KR", "CHN": "CN", "AUS": "AU",
            "NZL": "NZ", "IND": "IN", "ZAF": "ZA", "EGY": "EG",
            "MAR": "MA", "TUN": "TN", "DZA": "DZ", "NGA": "NG",
            "GHA": "GH", "SEN": "SN", "CMR": "CM", "CIV": "CI",
        }
        iso2 = iso3_to_iso2.get(str(country_id).upper())
        if not iso2:
            return "🌐"
        return "".join(chr(127397 + ord(char)) for char in iso2)

    @staticmethod
    def _country_rows(data: dict) -> list[dict]:
        for key in ("countries", "data", "items"):
            value = data.get(key)
            if isinstance(value, list):
                return value
        return []

    @staticmethod
    def _league_rows(data: dict) -> list[dict]:
        value = data.get("leagues")
        if isinstance(value, list):
            return value
        return []

    @staticmethod
    def _club_rows(data: object) -> list[dict]:
        """Normalize league-table responses into club dictionaries."""
        if isinstance(data, list):
            return [x for x in data if isinstance(x, dict)]

        if not isinstance(data, dict):
            return []

        # Some Soccerverse table responses expose rows directly under
        # common collection keys.
        for key in ("clubs", "teams", "table", "standings", "items"):
            value = data.get(key)
            if isinstance(value, list):
                return [x for x in value if isinstance(x, dict)]

        # Datacentre/MCP league-table responses can use:
        # {"meta": {"fields": [...]}, "data": {"1764": [[...], ...]}}
        payload = data.get("data")
        if isinstance(payload, list):
            return [x for x in payload if isinstance(x, dict)]

        if isinstance(payload, dict):
            fields = ((data.get("meta") or {}).get("fields") or [])
            rows = []

            for value in payload.values():
                if not isinstance(value, list):
                    continue

                for row in value:
                    if isinstance(row, dict):
                        rows.append(row)
                    elif isinstance(row, list) and fields:
                        rows.append(dict(zip(fields, row)))

            return rows

        return []

    def _load_saved_clubs(self) -> None:
        try:
            if self._saved_clubs_path.exists():
                data = json.loads(self._saved_clubs_path.read_text(encoding="utf-8"))
                if isinstance(data, list):
                    self._saved_clubs = [x for x in data if isinstance(x, dict)][:10]
        except Exception:
            self._saved_clubs = []

    def _save_saved_clubs(self) -> None:
        try:
            self._saved_clubs_path.write_text(
                json.dumps(self._saved_clubs[:10], ensure_ascii=False, indent=2),
                encoding="utf-8",
            )
        except Exception as exc:
            self.status.setText(f"Errore salvataggio club: {exc}")

    def _refresh_saved_clubs(self) -> None:
        self.saved_club_list.clear()
        for slot in range(10):
            club = self._saved_clubs[slot] if slot < len(self._saved_clubs) else None
            if club:
                club_id = int(club.get("club_id"))
                name = RINCON_NAMES.club_name(
                    club_id,
                    str(club.get("club_name") or f"CLUB {club_id}"),
                )
                country_id = str(club.get("country_id") or "")
                flag = self._flag_for_country(country_id)
                item = QListWidgetItem(
                    f"{slot + 1:02d}   {flag}   {name.upper()}\n"
                    f"CLUB ID {club_id}   •   {country_id}"
                )
                item.setData(Qt.ItemDataRole.UserRole, {"club_id": club_id, "club_name": name})
            else:
                item = QListWidgetItem(f"{slot + 1:02d}   —   SLOT LIBERO")
                item.setData(Qt.ItemDataRole.UserRole, None)
            self.saved_club_list.addItem(item)

    def _saved_club_clicked(self, item: QListWidgetItem) -> None:
        data = item.data(Qt.ItemDataRole.UserRole) or {}
        club_id = data.get("club_id")
        club_name = str(data.get("club_name") or "")
        if club_id is not None and club_name:
            self._open_club_matches(int(club_id), club_name)

    def _save_current_club(self) -> None:
        if not getattr(self, "_current_club", None):
            return
        club = dict(self._current_club)
        club_id = int(club["club_id"])
        for existing in self._saved_clubs:
            if int(existing.get("club_id", -1)) == club_id:
                self.status.setText(f"CLUB {club_id} GIÀ SALVATO")
                return
        if len(self._saved_clubs) >= 10:
            self.status.setText("I 10 SLOT SONO GIÀ OCCUPATI")
            return
        self._saved_clubs.append(club)
        self._save_saved_clubs()
        self._refresh_saved_clubs()
        self.status.setText(f"{club['club_name'].upper()} SALVATO NELLO SLOT {len(self._saved_clubs)}")

    def _remove_selected_saved_club(self) -> None:
        row = self.saved_club_list.currentRow()
        if row < 0 or row >= len(self._saved_clubs):
            return
        removed = self._saved_clubs.pop(row)
        self._save_saved_clubs()
        self._refresh_saved_clubs()
        self.status.setText(f"CLUB {removed.get('club_id')} RIMOSSO")

    def _load_countries(self) -> list[dict]:
        countries = []
        page = 1

        while page <= 20:
            data = self._mcp_call(
                "get_countries",
                {"page": page},
            )
            rows = self._country_rows(data)
            countries.extend(rows)

            pagination = data.get("pagination") or {}
            total_pages = int(pagination.get("total_pages") or page)

            if page >= total_pages or not rows:
                break

            page += 1

        return countries

    def _load_leagues(self, country_id: str) -> list[dict]:
        data = self._mcp_call(
            "get_leagues",
            {"country_id": country_id},
        )
        return self._league_rows(data)

    def _load_clubs(self, country_id: str, division: int) -> list[dict]:
        # MCP get_league_tables uses country_id + division.
        data = self._mcp_call(
            "get_league_tables",
            {
                "country_id": country_id,
                "division": division,
            },
        )
        return self._club_rows(data)

    def _club_name(self, club_id, fallback: str = "") -> str:
        return RINCON_NAMES.club_name(club_id, fallback)

    def _competition_name(self, row: dict, fallback: str = "") -> str:
        return RINCON_NAMES.competition_name(row, fallback)

    def _live_competition_name(self, row: dict, fallback: str = "") -> str:
        """Resolve a fixture's real competition from its actual competition ID."""
        country = str(row.get("country_id") or row.get("country") or "").upper()
        comp_id = (
            row.get("comp_id")
            or row.get("competition_id")
            or row.get("league_id")
            or row.get("cup_id")
        )
        if comp_id is None:
            return RINCON_NAMES.competition_name(row, fallback)

        key = f"{country}:{comp_id}"
        if key in self._competition_cache:
            return self._competition_cache[key]

        # First ask Soccerverse which league owns this numeric competition ID.
        # This is authoritative for distinguishing a league fixture from a cup
        # fixture; the Rincon pack then supplies the human-facing name.
        try:
            if country:
                leagues = self._league_rows(
                    self._mcp_call("get_leagues", {"country_id": country})
                )
                for league in leagues:
                    live_id = league.get("league_id") or league.get("id")
                    if live_id is not None and str(live_id) == str(comp_id):
                        division = league.get("division") or league.get("league_division")
                        name = RINCON_NAMES.league_name(
                            country,
                            division,
                            str(league.get("league_name") or fallback),
                        )
                        if name:
                            self._competition_cache[key] = name
                            return name
        except Exception:
            pass

        # If it is not a league, inspect the country's actual cups.
        try:
            if country:
                cups_data = self._mcp_call("get_cups_by_country", {"country_id": country})
                cups = cups_data.get("data", cups_data) if isinstance(cups_data, dict) else cups_data
                if isinstance(cups, list):
                    for cup in cups:
                        live_id = (
                            cup.get("cup_id")
                            or cup.get("comp_id")
                            or cup.get("id")
                        ) if isinstance(cup, dict) else None
                        if live_id is not None and str(live_id) == str(comp_id):
                            name = RINCON_NAMES.cup_name(
                                country,
                                cup.get("cup_id") or cup.get("comp_id") or cup.get("id"),
                                str(cup.get("cup_name") or cup.get("name") or fallback),
                            )
                            if name:
                                self._competition_cache[key] = name
                                return name
        except Exception:
            pass

        name = RINCON_NAMES.competition_name(row, fallback)
        self._competition_cache[key] = name
        return name

    def _schedule_matches(self, schedule) -> list[MatchSearchResult]:
        matches = []
        for item in schedule:
            try:
                home_id = item.get("home_club")
                away_id = item.get("away_club")
                home_fallback = str(item.get("home_club_name") or "HOME")
                away_fallback = str(item.get("away_club_name") or "AWAY")

                matches.append(
                    MatchSearchResult(
                        fixture_id=int(item["fixture_id"]),
                        home_team=self._club_name(home_id, home_fallback),
                        away_team=self._club_name(away_id, away_fallback),
                        score=f'{item["home_goals"]}-{item["away_goals"]}',
                        played=bool(item["played"]),
                        datetime=str(item["datetime"]),
                        competition=self._live_competition_name(
                            item,
                            str(item.get("comp_name") or item.get("league_name") or ""),
                        ),
                    )
                )
            except (KeyError, TypeError, ValueError):
                continue

        matches.sort(key=lambda match: (match.datetime, match.fixture_id))
        return matches

