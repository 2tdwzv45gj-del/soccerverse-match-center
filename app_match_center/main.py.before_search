    def toggle_play(self) -> None:
        if self.timer.isActive():
            self.timer.stop()
            self.play_button.setText("▶  PLAY")
            self.status.setText("PAUSED")
        else:
            if self.replay.elapsed_seconds >= self.replay.duration_seconds:
                self.reset_replay()

            if not self._audio_started:
                self.audio_player.start_whistle()
                self._audio_started = True

            self.timer.start()
            self.play_button.setText("Ⅱ  PAUSE")
            self.status.setText("LIVE")

    def tick(self) -> None:
        state = self.replay.advance(0.1)

        self.score.setText(
            f"{state.home_score}  —  {state.away_score}"
        )
        self.minute.setText(f"{state.match_minute}'")

        # Audio: trigger una sola volta quando entra una nuova scena.
        if state.current_action_id != self._last_audio_action_id:
            self._last_audio_action_id = state.current_action_id

            if state.current_action_id is not None:
                official_event = next(
                    (
                        event
                        for event in self.match_data.events
                        if int(event.get("time", -1)) == state.match_minute
                        and str(event.get("event_type", "")).upper()
                        in {
                            "GOAL",
                            "REDCARD",
                            "RED_CARD",
                            "SENDING_OFF",
                            "SUB",
                            "SUBSTITUTION",
                        }
                    ),
                    None,
                )

                if official_event is not None:
                    event_type = str(
                        official_event.get("event_type", "")
                    ).upper()
                    event_id = int(
                        official_event.get("match_event_id", state.current_action_id)
                    )

                    if event_type == "GOAL":
                        intensity = self.audio_engine.goal_intensity(False)
                        self.audio_player.goal(event_id, intensity)

                    elif event_type in {
                        "REDCARD",
                        "RED_CARD",
                        "SENDING_OFF",
                    }:
                        intensity = self.audio_engine.red_card_intensity()
                        self.audio_player.red_card(event_id, intensity)

                    elif event_type in {
                        "SUB",
                        "SUBSTITUTION",
                    }:
                        intensity = self.audio_engine.substitution_intensity()
                        self.audio_player.substitution(event_id, intensity)

        if state.current_kind == "goal":
            current_scene = (
                state.visible_scenes[-1].scene
                if state.visible_scenes
                else None
            )
            goal_minute = (
                current_scene.match_minute
                if current_scene
                else state.match_minute
            )
            goal_player = (
                current_scene.player_name
                if current_scene and current_scene.player_name
                else "Azione di squadra"
            )
            self.scorer.setText(
                f"{goal_minute}'  {goal_player.upper()}"
            )
        else:
            self.scorer.setText("")

        self.replay_status.setText(
            f"{state.elapsed_seconds:05.1f} / "
            f"{self.replay.duration_seconds:.1f}s"
        )

        while self.feed_layout.count():
            item = self.feed_layout.takeAt(0)
            if item.widget() is not None:
                item.widget().deleteLater()

        for visible in state.visible_scenes[-12:]:
            scene = visible.scene
            player = scene.player_name or "Azione di squadra"
            club = scene.club_name or "MATCH"
            label = QLabel(f"{scene.match_minute}\x27   {club.upper()}   •   {player}")
            label.setObjectName("feedItem")
            self.feed_layout.addWidget(label)

        if state.current_kind == "goal":
            self.status.setText("GOAL")

        if self.replay.elapsed_seconds >= self.replay.duration_seconds:
            if not self._audio_finished:
                self.audio_player.final_whistle()
                self._audio_finished = True

            self.timer.stop()
            self.play_button.setText("↻  REPLAY")
            self.status.setText("FINAL")

    def reset_replay(self) -> None:
        self.timer.stop()

        self.audio_player.reset()
        self._last_audio_action_id = None
        self._audio_started = False
        self._audio_finished = False

        state = self.replay.reset()

        self.play_button.setText("▶  PLAY")
        self.status.setText("READY")
        self.score.setText(
            f"{state.home_score}  —  {state.away_score}"
        )
        self.minute.setText(f"{state.match_minute}'")
        self.scorer.setText("")
        self.replay_status.setText(
            f"0.0 / {self.replay.duration_seconds:.1f}s"
        )

    def change_mode(self, mode: ReplayMode) -> None:
        self.timer.stop()

        self.replay = MatchReplayController(
            self.replay.match_data,
            mode,
        )

        self.reset_replay()


